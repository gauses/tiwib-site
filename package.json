{
  "name": "tiwib-site",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prepare:catalog": "node scripts/build-catalog.mjs",
    "predev": "npm run prepare:catalog",
    "prebuild": "npm run prepare:catalog",
    "dev": "vite --port 5174",
    "build": "vite build",
    "postbuild": "node scripts/build-static-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "report:missing-links": "node scripts/report-missing-outbound-links.mjs",
    "cf:dev": "npm run build && npx wrangler pages dev dist --project-name tiwib-site",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name tiwib-site",
    "cf:tail": "npx wrangler pages deployment tail --project-name tiwib-site"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
